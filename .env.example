# Local settings. "python apex.py up" copies this file to .env the first time.
# .env is git-ignored: never commit real passwords.
# Avoid the characters  @  /  "  and spaces in passwords.

# Must be the same as ORACLE_PASSWORD in aviation-otp-observatory/.env
# (used to install APEX and ORDS into the database, and by "apex.py install").
ORACLE_PASSWORD=Oracle_Sys_2026

# Schema of this application (views, API package, REST services)
OTP_APP_PASSWORD=Otp_App_Web_2026

# APEX workspace OTP: developer account used to build the application
APEX_DEV_USER=DEV
APEX_DEV_PASSWORD=Dev_Apex_2026

# ORDS_PUBLIC_USER, the database account ORDS connects with (created by the ORDS install)
ORDS_PUBLIC_PASSWORD=Ords_Public_2026

# Host port for ORDS / APEX
ORDS_PORT=8181

# Container name of the database (from aviation-otp-observatory)
DB_CONTAINER=otp-oracle

# Container image used as the Java 17 runtime for ORDS 26.3.1 (apex.py downloads ORDS
# itself). Pinned: newer tags are built on Oracle Linux 10, whose glibc
# needs an x86-64-v3 CPU (AVX2). Many VirtualBox VMs (Hyper-V active on the
# Windows host) do not expose AVX2 and the container dies with
# "Fatal glibc error: CPU does not support x86-64-v3".
ORDS_IMAGE=container-registry.oracle.com/database/ords:24.4.0
